#!/usr/bin/env bash
# Kiểm tra commit message theo Conventional Commits — xem docs/GIT_FLOW.md mục 2.
msg=$(head -n1 "$1")
case "$msg" in Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;; esac
if ! printf '%s' "$msg" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .+'; then
  echo "✗ Commit message sai chuẩn: \"$msg\"" >&2
  echo "  Đúng dạng: <type>(<scope>): <mô tả>  — VD: fix(mobile): sửa lỗi bàn phím che ô nhập" >&2
  echo "  Xem docs/GIT_FLOW.md" >&2
  exit 1
fi
if [ ${#msg} -gt 100 ]; then
  echo "✗ Dòng đầu commit dài ${#msg} ký tự (tối đa 100)." >&2
  exit 1
fi
